# Copie en .env puis ajuste. Toutes les valeurs ont un défaut dans compose.

# --- oMLX (tourne en NATIF sur le Mac, pas dans un conteneur) ---------------
# Un conteneur ne voit pas le localhost de l'hôte. Choisis selon ton moteur :
#   Podman         http://host.containers.internal:8000/v1
#   Docker Desktop http://host.docker.internal:8000/v1
# Si aucun des deux ne résout, mets l'IP du Mac sur son réseau local.
# Vérifie aussi qu'oMLX écoute sur 0.0.0.0 : lié à 127.0.0.1, il est invisible
# depuis les conteneurs même avec le bon nom d'hôte.
OMLX_BASE_URL=http://host.containers.internal:8000/v1

# Si oMLX exige une clé, mets-la ici : sans elle, TOUS les appels LLM et
# embedding repartent en 401. Laisse vide si oMLX n'en demande pas.
OMLX_API_TOKEN=

OMLX_LLM_MODEL=qwen3-8b
OMLX_EMBED_MODEL=bge-m3

# Doit correspondre EXACTEMENT au modèle d'embedding (bge-m3 = 1024).
# La dimension est inscrite dans la base au premier démarrage : une base créée
# avec une autre dimension est refusée au démarrage par mem0-rs.
EMBEDDING_DIMS=1024

# --- mem0-rs ---------------------------------------------------------------
# Dossier de l'HÔTE qui contient la base mem0-rs.db (et ses -wal, -shm,
# .lock, plus les instantanés de backups/), relatif à mem0-stack/. Crée-le (`mkdir -p`) avant `compose up` :
# tous les moteurs ne le créent pas. C'est aussi la cible de `mem0-rs import`
# quand tu migres l'ancienne pile (voir mem0-stack/README.md).
MEM0_RS_DATA_DIR=./mem0-rs-data

# Port publié sur 127.0.0.1 de l'hôte (le conteneur écoute toujours sur 8321).
MEM0_RS_PORT=8321

# Nom du conteneur, lu aussi par doctor.sh.
MEM0_RS_CONTAINER=mem0-rs

# Instantanés de la base (VACUUM INTO) dans $MEM0_RS_DATA_DIR/backups : un
# toutes les MEM0_BACKUP_INTERVAL_HOURS heures (0 = coupés), les
# MEM0_BACKUP_KEEP plus récents gardés.
MEM0_BACKUP_INTERVAL_HOURS=24
MEM0_BACKUP_KEEP=7

# --- Optionnel -------------------------------------------------------------
# Si définie, le plugin doit envoyer la même valeur dans X-Mem0-Token
# (variable MEM0_HTTP_TOKEN côté OMP). Le service n'écoute que sur 127.0.0.1,
# donc c'est de la défense en profondeur.
MEM0_HTTP_TOKEN=
