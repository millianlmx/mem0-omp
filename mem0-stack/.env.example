# Copier en .env et ajuster selon ce que tu as chargé dans oMLX
# (vérifie les noms exacts avec: curl http://localhost:8000/v1/models)

OMLX_LLM_MODEL=qwen3-8b
OMLX_EMBED_MODEL=bge-m3
EMBEDDING_DIMS=1024

# Token pour oMLX — si oMLX exige une authentification (Bearer token),
# placez-le ici. Laisser vide si oMLX n'a pas d'API key.
OMLX_API_TOKEN=

# Optionnel : si définie, mem0-http exige ce token dans le header
# X-Mem0-Token sur chaque requête (défense en profondeur — le port est déjà
# bindé en 127.0.0.1 dans docker-compose.yml).
MEM0_HTTP_TOKEN=
