# Copie en .env puis ajuste. Toutes les valeurs ont un défaut dans compose.

# --- oMLX (tourne en NATIF sur le Mac, pas dans un conteneur) ---------------
# Un conteneur ne voit pas le localhost de l'hôte. Choisis selon ton moteur :
#   Podman         http://host.containers.internal:8000/v1
#   Docker Desktop http://host.docker.internal:8000/v1
# Si aucun des deux ne résout, mets l'IP du Mac sur son réseau local.
# Vérifie aussi qu'oMLX écoute sur 0.0.0.0 : lié à 127.0.0.1, il est invisible
# depuis les conteneurs même avec le bon nom d'hôte.
OMLX_BASE_URL=http://host.containers.internal:8000/v1

# Si oMLX exige une clé, mets-la ici : sans elle, TOUS les appels LLM et
# embedding repartent en 401 — et mem0 les remonte comme une erreur de
# connexion, pas comme un refus d'authentification. Laisse vide si oMLX n'en
# demande pas (le client OpenAI en veut une non vide de toute façon, memory_config.py
# y substitue une valeur factice).
OMLX_API_TOKEN=

OMLX_LLM_MODEL=qwen3-8b
OMLX_EMBED_MODEL=bge-m3

# Doit correspondre EXACTEMENT au modèle d'embedding (bge-m3 = 1024).
# La collection Qdrant est créée avec cette dimension au premier appel : la
# changer ensuite fait rejeter toutes les écritures. Supprime ./qdrant_storage
# pour repartir de zéro.
EMBEDDING_DIMS=1024

# --- Qdrant ----------------------------------------------------------------
# Clé LOCALE par défaut (pas un secret de production) : elle ferme l'accès non
# authentifié à l'API Qdrant publiée sur 127.0.0.1. Le service `qdrant` (sous
# QDRANT__SERVICE__API_KEY) et le service `mem0-http` (sous QDRANT_API_KEY)
# lisent la MÊME variable d'ici, donc les deux valeurs ne peuvent pas diverger.
# La changer impose de recréer les deux conteneurs, qui gardent sinon l'ancienne
# valeur : `compose up -d --force-recreate`. Elle n'est pas dérivée du stockage,
# donc la changer ne touche pas aux données.
QDRANT_API_KEY=mem0-local-qdrant-key

# --- Optionnel -------------------------------------------------------------
# Si définie, le plugin doit envoyer la même valeur dans X-Mem0-Token
# (variable MEM0_HTTP_TOKEN côté OMP). Le service n'écoute que sur 127.0.0.1,
# donc c'est de la défense en profondeur.
MEM0_HTTP_TOKEN=
