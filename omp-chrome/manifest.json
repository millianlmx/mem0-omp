{
  "manifest_version": 3,
  "name": "OMP Poste de travail",
  "description": "Observe votre travail dans Chrome, agit pour l'agent OMP dans une fenêtre à part et transcrit les meetings sur ce Mac. Demande toujours votre approbation avant d'envoyer un message.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "idle", "alarms", "offscreen", "tabCapture", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "action": {
    "default_title": "OMP Poste de travail",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/observe-loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "page/*.js", "lib/*.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
