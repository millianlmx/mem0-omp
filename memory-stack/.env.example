# Copie en .env puis ajuste. Toutes les valeurs ont un défaut dans compose.

# --- oMLX (tourne en NATIF sur le Mac, pas dans un conteneur) ---------------
# Un conteneur ne voit pas le localhost de l'hôte. Choisis selon ton moteur :
#   Podman         http://host.containers.internal:8000/v1
#   Docker Desktop http://host.docker.internal:8000/v1
# Si aucun des deux ne résout, mets l'IP du Mac sur son réseau local.
# Vérifie aussi qu'oMLX écoute sur 0.0.0.0 : lié à 127.0.0.1, il est invisible
# depuis les conteneurs même avec le bon nom d'hôte.
OMLX_BASE_URL=http://host.containers.internal:8000/v1

# Si oMLX exige une clé, mets-la ici : sans elle, TOUS les appels LLM et
# embedding repartent en 401. Laisse vide si oMLX n'en demande pas.
OMLX_API_TOKEN=

OMLX_LLM_MODEL=qwen3-8b
# Le chat (rêve, add infer=true) sur un autre serveur que les embeddings ; vides :
# OMLX_BASE_URL et OMLX_API_TOKEN. OMLX_CHAT_BASE_URL=off coupe le chat (le rêve
# ne compare plus, add infer=true est refusé).
OMLX_CHAT_BASE_URL=
OMLX_CHAT_API_TOKEN=
OMLX_EMBED_MODEL=bge-m3

# Doit correspondre EXACTEMENT au modèle d'embedding (bge-m3 = 1024).
# La dimension est inscrite dans la base au premier démarrage : une base créée
# avec une autre dimension est refusée au démarrage par memory-rs.
EMBEDDING_DIMS=1024

# --- memory-rs ---------------------------------------------------------------
# Dossier de l'HÔTE qui contient la base memory-rs.db (et ses -wal, -shm,
# .lock, plus les instantanés de backups/), relatif à memory-stack/. Crée-le (`mkdir -p`) avant `compose up` :
# tous les moteurs ne le créent pas. C'est aussi la cible de `memory-rs import`
# quand tu migres l'ancienne pile (voir memory-stack/README.md).
MEMORY_RS_DATA_DIR=./memory-rs-data

# Port publié sur 127.0.0.1 de l'hôte (le conteneur écoute toujours sur 8321).
MEMORY_RS_PORT=8321

# Nom du conteneur, lu aussi par doctor.sh.
MEMORY_RS_CONTAINER=memory-rs

# Instantanés de la base (VACUUM INTO) dans $MEMORY_RS_DATA_DIR/backups : un
# toutes les MEMORY_BACKUP_INTERVAL_HOURS heures (0 = coupés), les
# MEMORY_BACKUP_KEEP plus récents gardés.
MEMORY_BACKUP_INTERVAL_HOURS=24
MEMORY_BACKUP_KEEP=7

# Fusion des classements sémantique et BM25 de la recherche : `additive`
# (défaut, le classement de l'ancien service Python, cf. THIRD_PARTY_NOTICES.md),
# `rrf` (Reciprocal Rank Fusion, de
# constante MEMORY_RRF_K) ou `graphe` (RRF plus le graphe de liens de la
# mémoire). Mesurer avant de changer : `memory-rs banc`
# (memory-rs/README.md § Recherche hybride).
MEMORY_SEARCH_FUSION=additive
MEMORY_RRF_K=60

# Rêve de la mémoire (memory-rs/README.md § Rêve) : toutes les
# MEMORY_DREAM_INTERVAL_MINUTES minutes (0 = coupé), chaque projet resté calme
# MEMORY_DREAM_QUIET_MINUTES minutes se réindexe, fait juger au LLM au plus
# MEMORY_DREAM_PAIRS paires de souvenirs très proches (doublon, remplacement,
# contradiction : des propositions, jamais des suppressions), et propose
# d'oublier ce qui n'a été ni rappelé ni relié depuis MEMORY_DREAM_FORGET_DAYS
# jours (0 = jamais).
MEMORY_DREAM_INTERVAL_MINUTES=60
MEMORY_DREAM_QUIET_MINUTES=10
MEMORY_DREAM_PAIRS=20
MEMORY_DREAM_FORGET_DAYS=180

# --- Optionnel -------------------------------------------------------------
# Si définie, le plugin doit envoyer la même valeur dans X-Memory-Token
# (variable MEMORY_HTTP_TOKEN côté OMP). Le service n'écoute que sur 127.0.0.1,
# donc c'est de la défense en profondeur.
MEMORY_HTTP_TOKEN=

# Jetons limités à des portées (agent_id) : `nom:jeton:scope1,scope2;…`, jeton de
# 16 à 512 caractères. Un tel jeton n'ouvre que ses portées (403 sinon) ;
# MEMORY_HTTP_TOKEN reste le jeton total.
MEMORY_HTTP_TOKENS=
