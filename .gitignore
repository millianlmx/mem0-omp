# Données locales du stack — jamais commitées
mem0-stack/qdrant_storage/
mem0-stack/.env
mem0-stack/mem0-rs/target/
mem0-stack/mem0-rs-data/
mem0-stack/migration/

node_modules/
# scripts/typecheck.sh : TypeScript épinglé (typescript/, par --prepare) et lien vers les types de l'hôte (node_modules)
.typecheck/
# Biome épinglé de scripts/lint.sh (installé par `bash scripts/lint.sh --prepare`)
.lint/
# Extension Chrome construite par scripts/chrome-extension.sh (et son dossier de construction transitoire)
omp-chrome/dist/
omp-chrome/dist.construction-*/
*.log
.DS_Store

# Contrat de pipeline /req→/specs→/impl→/review — artefact transitoire par feature
.omp/pipeline/
# Worktrees des agents de Claude Code (un dépôt complet chacun) : ni commités, ni
# parcourus par les tests qui lisent le dépôt, ni recopiés dans leurs copies jetables
.claude/worktrees/
__pycache__/

# Artefacts de build de la coque Swift : produits SwiftPM et bundle .app assemblé
omp-console/.build/
omp-console/.build-app/
omp-console/.build-tests/
omp-console/.build-check/
omp-console/.build-review/
omp-console/.build-run/
omp-console/.build-impl/
omp-console/.build-recipe/
# Scratch persistant de socle-app-swift/AC-1 (test/outillage/check.test.ts) : `swift build` seul
omp-console/.build-node/
omp-console/build/
# DerivedData de l'app iOS (xcodebuild -derivedDataPath omp-console/.build-ios)
omp-console/.build-ios/
