{
  // Biome (version épinglée dans scripts/lint.sh) : lint + format du TypeScript de omp-mem0-req/, omp-harness/, omp-chrome/, scripts/ et test/ seulement.
  "root": true,
  "vcs": { "enabled": false },
  // `!!` : les worktrees d'agents (.claude/worktrees/, des dépôts complets) ne sont même pas parcourus — sinon
  // leur propre biome.jsonc est refusé comme seconde racine.
  "files": {
    "includes": [
      "omp-mem0-req/**/*.ts",
      "omp-harness/**/*.ts",
      "omp-chrome/**/*.ts",
      "scripts/**/*.ts",
      "test/**/*.ts",
      "!!**/.claude/worktrees"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120, "lineEnding": "lf" },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Convention du dépôt : `!` après un accès indexé ou un `.find()` (≈ 1600 sites), car tsconfig.json est
        // `strict` SANS `noUncheckedIndexedAccess`. Le correctif proposé (`?.`) remplacerait un TypeError par un
        // `undefined` silencieux : il changerait le comportement.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // Les tests cherchent volontairement des littéraux `${…}` de sources Swift et de sorties App Shortcut
        // (test/outillage/check.test.ts:691, test/console/ios-memoire-graphe.test.ts:270).
        "noTemplateCurlyInString": "off"
      }
    }
  },
  // Le tri des imports n'est ni du lint ni du format (hors B-1) : l'ordre des imports reste celui écrit à la main.
  "assist": { "enabled": false },
  // Règles « anti-slop » en GritQL (scripts/biome-rules/*.grit, documentées dans DEVELOPPEMENT.md § CI) qui font
  // respecter la politique de tests du dépôt (CONTRIBUTING.md : on prouve un comportement, pas un état figé ni l'écho
  // d'une doublure). Les globs sont comparés au chemin ABSOLU : d'où le `**/` initial. Ces quatre-là n'avaient aucune
  // violation à la pose : ERREUR sur tout leur périmètre. Les deux qui en avaient (no-sleep-in-tests, no-unknown-returns)
  // sont dans scripts/biome-rules/baseline.jsonc, qui ne fait que décroître.
  "extends": ["./scripts/biome-rules/baseline.jsonc"],
  "plugins": [
    { "path": "./scripts/biome-rules/no-snapshot-tests.grit", "includes": ["**/test/**/*.ts"] },
    { "path": "./scripts/biome-rules/no-module-mocking.grit", "includes": ["**/test/**/*.ts"] },
    { "path": "./scripts/biome-rules/no-only-tests.grit", "includes": ["**/test/**/*.ts"] },
    { "path": "./scripts/biome-rules/no-tautological-assertions.grit", "includes": ["**/test/**/*.ts"] }
  ]
}
