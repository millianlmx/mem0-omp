{
  "listen": { "host": "127.0.0.1", "port": 8790 },
  "dataDir": "/var/lib/omp-harness/state",
  "worktreesDir": "/var/lib/omp-harness/worktrees",
  "ompBin": "/usr/local/bin/omp",
  "git": { "authorName": "omp-harness", "authorEmail": "omp-harness@vps.local" },
  "runner": {
    "slots": 5,
    "memoryMax": "1G",
    "oomScoreAdjust": 300,
    "profile": "pipeline",
    "stepTimeoutSec": 5400,
    "retryBackoffSec": [120, 600, 1800],
    "failoverOn": ["rate_limit", "server_error", "network"]
  },
  "heavy": {
    "slots": 2,
    "memoryMax": "4G",
    "cpuQuota": "300%",
    "user": "omp-heavy",
    "oomScoreAdjust": 800,
    "oomRetries": 2,
    "cargoTargetRoot": "/var/cache/omp-harness/cargo",
    "readWritePaths": ["/var/cache/omp-harness/sccache", "/var/cache/omp-harness/pnpm-store", "/var/lib/omp-heavy"],
    "env": {
      "HOME": "/var/lib/omp-heavy",
      "RUSTC_WRAPPER": "sccache",
      "SCCACHE_DIR": "/var/cache/omp-harness/sccache",
      "npm_config_store_dir": "/var/cache/omp-harness/pnpm-store"
    }
  },
  "admission": { "reserveMiB": 2048, "runnerMiB": 1024, "heavyMiB": 4096 },
  "models": {
    "fast": [
      { "provider": "anthropic", "model": "claude-haiku-5-5" },
      { "provider": "openrouter", "model": "anthropic/claude-haiku-5-5" }
    ],
    "standard": [
      { "provider": "anthropic", "model": "claude-sonnet-5-5" },
      { "provider": "openrouter", "model": "anthropic/claude-sonnet-5-5" }
    ],
    "heavy": [
      { "provider": "anthropic", "model": "claude-opus-5-5" },
      { "provider": "openrouter", "model": "anthropic/claude-opus-5-5" }
    ]
  },
  "stepTiers": { "req": "heavy", "specs": "heavy", "impl": "standard", "fix": "standard", "review": "heavy" },
  "providers": {
    "anthropic": { "capacity": 20, "refillPerMinute": 20 },
    "openrouter": { "capacity": 10, "refillPerMinute": 10 }
  },
  "review": {
    "fixCap": 3,
    "maxDiffLines": 300,
    "diffCount": "code",
    "specsGate": "auto",
    "autoMergeRisk": "medium",
    "escalationTimeoutSec": 3600,
    "mergeRetries": 3,
    "mergeWaitSec": 7200,
    "crossProvider": true
  },
  "challenge": { "steps": ["req", "specs"], "tier": "heavy" },
  "oracle": { "url": "http://127.0.0.1:8321", "token": null },
  "dreams": { "checkMinutes": 60, "minFacts": 5, "maxDelayHours": 24, "tier": "standard" },
  "pilot": { "actionsPerRun": 3, "tier": "heavy", "allRuns": true },
  "events": { "retentionDays": 30 },
  "monitoring": { "runBudgetUsd": null, "pauseOnBudget": false, "dailyBudgetUsd": null },
  "notify": {
    "url": "https://ntfy.sh/<topic>",
    "events": [
      "escalations",
      "specs_ready",
      "verdict",
      "run_failed",
      "project_done",
      "merged",
      "budget_exceeded",
      "daily_budget_reached",
      "pilot",
      "vigie_incident",
      "vigie_silent"
    ],
    "digestHour": 8
  },
  "memory": { "runnerMode": true },
  "workstation": { "policy": { "providers": ["anthropic"] } },
  "repos": [
    {
      "name": "mon-produit",
      "path": "/var/lib/omp-harness/repos/mon-produit",
      "mainBranch": "main",
      "tests": {
        "touched": "npm run -s test:touched -- {files}",
        "full": "npm test",
        "pattern": "test/**/*.test.ts"
      },
      "checks": { "lint": "npm run -s lint", "typecheck": "npm run -s typecheck" },
      "merge": "local",
      "remote": "origin",
      "maxParallel": 3
    },
    {
      "name": "client-corpo",
      "path": "/var/lib/omp-harness/repos/client-corpo",
      "tests": { "touched": "npm test -- {files}", "full": "npm test", "pattern": null },
      "merge": "gh",
      "remote": "origin",
      "sshKey": "/var/lib/omp-harness/.ssh/repos/client-corpo",
      "privacy": "local-only",
      "models": { "heavy": ["omlx/qwen3-coder-30b"] },
      "git": { "name": "Prénom Nom", "email": "prenom.nom@client.example" },
      "gh": { "configDir": "/var/lib/omp-harness/gh/client-corpo" },
      "memory": { "tokenEnv": "MEM0_TOKEN_CLIENT_CORPO" }
    },
    {
      "name": "client-gitlab",
      "path": "/var/lib/omp-harness/repos/client-gitlab",
      "tests": { "touched": "npm test -- {files}", "full": "npm test", "pattern": null },
      "merge": "gh",
      "remote": "origin",
      "sshKey": "/var/lib/omp-harness/.ssh/repos/client-gitlab",
      "forge": "gitlab",
      "gitlab": { "host": "gitlab.client.example", "tokenEnv": "GITLAB_TOKEN_CLIENT_GITLAB" },
      "git": { "name": "Prénom Nom", "email": "prenom.nom@client.example" }
    }
  ]
}
