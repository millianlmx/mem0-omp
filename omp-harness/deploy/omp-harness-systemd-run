#!/bin/bash
# Le lanceur ROOT du harness : la seule porte de `omp-harness` vers systemd.
#
# Installé en /usr/local/libexec/omp-harness-systemd-run (root:root 0755) et
# autorisé par sudoers pour le seul user `omp-harness`, SANS SETENV : sudo remet
# l'environnement à zéro (ni BASH_ENV, ni LD_*, ni PATH de l'appelant). Il n'exécute que les TROIS
# lignes que le service construit, après les avoir validées mot à mot :
#
#   --wait --pipe … --unit=omp-runner-… -- OMP_BIN …
#                                        un runner : service transitoire forcé
#                                        User=RUNNER_USER (jamais root, jamais le service),
#                                        son seul worktree inscriptible, son seul clone
#                                        lisible (les autres masqués), avec les clés de
#                                        RUNNER_ENV_FILE (root seul) puis celles déclarées
#                                        par l'API (*_API_KEY)
#   --wait --pipe …  -- HEAVY_SHELL -c CMD un job heavy : service transitoire forcé
#                                        User=HEAVY_USER, PrivateNetwork=yes,
#                                        chemins inscriptibles sous WRITABLE_ROOTS
#   --stop omp-(runner|heavy)-….scope|service
#
# Toute autre forme est refusée (sortie 64). Sans ce contrôle, autoriser
# `systemd-run` à `omp-harness` reviendrait à lui donner root (`-p User=root`).
#
# La configuration (/etc/omp-harness/launcher.conf, root:root 0644) est LUE, jamais
# sourcée : seules les clés connues sont prises. OMP_HARNESS_LAUNCHER_DRY_RUN=1
# imprime la ligne finale au lieu de l'exécuter (tests) ; la configuration de
# remplacement OMP_HARNESS_LAUNCHER_CONF n'est honorée qu'en essai ET hors root.
set -euo pipefail
set -f
umask 0002
# /run/current-system/sw/bin : les outils du système sous NixOS (absent ailleurs).
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/run/current-system/sw/bin
export PATH
cd /

WORKTREES_ROOT=/var/lib/omp-harness/worktrees
# Les clones des dépôts : masqués pour un runner, sauf le sien (en lecture).
REPOS_ROOT=/var/lib/omp-harness/repos
WRITABLE_ROOTS="/var/lib/omp-harness/worktrees /var/cache/omp-harness /var/lib/omp-heavy"
HEAVY_USER=omp-heavy
RUNNER_USER=omp-runner
WORK_GROUP=omp-work
HEAVY_SLICE=omp-harness-heavy.slice
RUNNER_SLICE=omp-harness-runners.slice
OMP_BIN=/usr/local/bin/omp
RUNNER_ENV_FILE=/etc/omp-harness/runner.env
# Les fichiers d'environnement des runners (root 0700), lus par systemd à leur démarrage.
RUNNER_ENV_DIR=/run/omp-harness-launcher
# Ce qu'un runner ne doit jamais voir, ajouté par le lanceur lui-même.
RUNNER_HIDDEN="/var/lib/omp-harness/state /var/lib/omp-heavy /var/lib/omp-mem0 /etc/omp-harness /run/dbus /run/docker.sock /var/run/docker.sock /run/systemd/private"
# Les fournisseurs déclarés par l'API (écrits par le service, pas par root) : leurs clés
# et le models.yml des fournisseurs compatibles OpenAI.
PROVIDERS_ENV_FILE=/var/lib/omp-harness/state/providers.env
PROVIDERS_MODELS_FILE=/var/lib/omp-harness/state/providers.models.yml
# Le bash des jobs heavy : `/bin/bash`, ou son chemin du store sous NixOS.
HEAVY_SHELL=/bin/bash
# Ce qu'un job heavy ne doit jamais voir, ajouté par le lanceur lui-même.
HEAVY_HIDDEN="/var/lib/omp-runner /var/lib/omp-harness/state /var/lib/omp-mem0 /etc/omp-harness /run/dbus /run/docker.sock /var/run/docker.sock /run/systemd/private"

DRY_RUN=0
CONF=/etc/omp-harness/launcher.conf
if [ "${OMP_HARNESS_LAUNCHER_DRY_RUN:-}" = "1" ]; then
  DRY_RUN=1
  if [ "$(id -u)" != "0" ] && [ -n "${OMP_HARNESS_LAUNCHER_CONF:-}" ]; then CONF="$OMP_HARNESS_LAUNCHER_CONF"; fi
fi

if [ -r "$CONF" ]; then
  while IFS='=' read -r key value; do
    case "$key" in
      WORKTREES_ROOT) WORKTREES_ROOT="$value" ;;
      REPOS_ROOT) REPOS_ROOT="$value" ;;
      RUNNER_ENV_DIR) RUNNER_ENV_DIR="$value" ;;
      RUNNER_HIDDEN) RUNNER_HIDDEN="$value" ;;
      WRITABLE_ROOTS) WRITABLE_ROOTS="$value" ;;
      HEAVY_USER) HEAVY_USER="$value" ;;
      RUNNER_USER) RUNNER_USER="$value" ;;
      WORK_GROUP) WORK_GROUP="$value" ;;
      HEAVY_SLICE) HEAVY_SLICE="$value" ;;
      RUNNER_SLICE) RUNNER_SLICE="$value" ;;
      OMP_BIN) OMP_BIN="$value" ;;
      RUNNER_ENV_FILE) RUNNER_ENV_FILE="$value" ;;
      PROVIDERS_ENV_FILE) PROVIDERS_ENV_FILE="$value" ;;
      PROVIDERS_MODELS_FILE) PROVIDERS_MODELS_FILE="$value" ;;
      HEAVY_HIDDEN) HEAVY_HIDDEN="$value" ;;
      HEAVY_SHELL) HEAVY_SHELL="$value" ;;
      *) ;;
    esac
  done < <(grep -E '^[A-Z_]+=' "$CONF" | sed 's/"//g')
fi

refuse() {
  echo "omp-harness-systemd-run : refusé — $*" >&2
  exit 64
}

# Équivalent portable de `realpath -m` (GNU seul ; le realpath BSD de macOS, où
# tournent les tests, n'a pas `-m`) : normalisation lexicale (`.`, `..`, `//`),
# résolution des liens du plus long préfixe existant (`cd -P`), puis des liens
# qui suivent (`readlink`, borné). Le reste, inexistant, est recollé tel quel.
canon() {
  local input="$1" hops=0 out seg rest prefix suffix link
  while :; do
    case "$input" in /*) ;; *) input="$PWD/$input" ;; esac
    out=""
    rest="$input"
    while [ -n "$rest" ]; do
      seg="${rest%%/*}"
      if [ "$seg" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
      case "$seg" in
        "" | .) ;;
        ..) out="${out%/*}" ;;
        *) out="$out/$seg" ;;
      esac
    done
    prefix="$out"
    suffix=""
    while [ -n "$prefix" ] && [ ! -d "$prefix" ]; do
      suffix="/${prefix##*/}$suffix"
      prefix="${prefix%/*}"
    done
    prefix=$(cd -P -- "${prefix:-/}" 2>/dev/null && pwd -P) || prefix="${prefix:-/}"
    [ "$prefix" = "/" ] && prefix=""
    # Premier composant restant : un lien (vers un fichier, ou cassé) se suit.
    seg="${suffix#/}"
    seg="${seg%%/*}"
    if [ -n "$seg" ] && [ -L "$prefix/$seg" ] && [ "$hops" -lt 40 ]; then
      hops=$((hops + 1))
      link=$(readlink -- "$prefix/$seg")
      case "$link" in /*) ;; *) link="$prefix/$link" ;; esac
      input="$link${suffix#/"$seg"}"
      continue
    fi
    out="$prefix$suffix"
    printf '%s\n' "${out:-/}"
    return 0
  done
}

# `path` est-il STRICTEMENT sous une des racines données (liens résolus) ?
under() {
  local target root resolved
  target=$(canon "$1")
  shift
  for root in "$@"; do
    resolved=$(canon "$root")
    case "$target" in "$resolved"/?*) return 0 ;; esac
  done
  return 1
}

# `path` est-il une des racines, ou dessous ?
within() {
  local target root resolved
  target=$(canon "$1")
  shift
  for root in "$@"; do
    resolved=$(canon "$root")
    [ "$target" = "$resolved" ] && return 0
    case "$target" in "$resolved"/?*) return 0 ;; esac
  done
  return 1
}

# Un fichier écrit par le service : régulier, pas un lien, et pas à root (avec
# fs.protected_hardlinks, un lien dur vers un fichier de root garde root pour
# propriétaire). Sans ce contrôle, le service ferait lire n'importe quel fichier à root.
service_file() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ "$(owner_uid "$1")" != "0" ]
}

# L'uid du propriétaire : `stat -c` (GNU, la cible) ou `stat -f` (BSD : macOS, où tournent les tests).
owner_uid() {
  stat -c %u -- "$1" 2>/dev/null || stat -f %u -- "$1"
}

run() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '%s\n' "$@"
    exit 0
  fi
  exec "$@"
}

size_re='^[0-9]+[KMGT]?$'
unit_id_re='^[A-Za-z0-9_-]+$'
# Un chemin que systemd et bash lisent pareil : absolu, sans espace, guillemet, joker, %, préfixe - ou +.
path_re='^/[A-Za-z0-9._/-]+$'
name_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'
# Le dossier d'une feature : un nom, ou `_audit-<id>` (le worktree d'un audit).
feature_re='^[A-Za-z0-9_][A-Za-z0-9._-]*$'

# Une valeur posée dans le fichier d'environnement d'un runner, entre apostrophes (systemd
# la lit telle quelle) : une paire de guillemets englobante est ôtée, et une valeur qui
# garderait un guillemet, une apostrophe, `\`, `$` ou un accent grave est écartée.
env_value() {
  local value="$1"
  case "$value" in \"*\" | \'*\') [ "${#value}" -ge 2 ] && value="${value:1:${#value}-2}" ;; esac
  [[ "$value" =~ ^[^\'\"\\\$\`[:cntrl:]]*$ ]] || return 1
  printf "'%s'" "$value"
}

# Un runner : un service transitoire (stdio gardés par --pipe) qui ne voit que SON
# worktree en écriture et SON clone en lecture — les autres worktrees et clones sont
# masqués (tmpfs en lecture seule) —, le reste du système en lecture seule, sans
# élévation. Le service ne choisit que la place du worktree, du clone et les limites ;
# l'user, le groupe, le bac à sable et les clés sont posés ici.
#
#   --wait --pipe --collect --service-type=exec --unit=omp-runner-ID --quiet --slice=…
#   --working-directory=WORKTREES_ROOT/<dépôt>/<feature> -p MemoryMax=X -p OOMScoreAdjust=N
#   [-p BindReadOnlyPaths=<clone>] [--setenv=MEM0_PROJECT_ID|MEM0_AUTOSETUP|MEM0_NUDGE|MEM0_MODE=…]…
#   -- OMP_BIN …
#
# Les clés (runner.env, puis les *_API_KEY de l'API, puis la scope mémoire) partent dans
# un fichier root 0600 de RUNNER_ENV_DIR que systemd lit au démarrage (EnvironmentFile=) :
# jamais sur la ligne de commande ni dans les propriétés de l'unité, lisibles de tous.
launch_runner() {
  [ "$#" -ge 14 ] || refuse "ligne de runner trop courte"
  [ "$1" = "--wait" ] && [ "$2" = "--pipe" ] && [ "$3" = "--collect" ] && [ "$4" = "--service-type=exec" ] \
    || refuse "options de runner inattendues"
  unit="${5#--unit=}"
  [ "$5" = "--unit=$unit" ] && [[ "$unit" =~ ^omp-runner- ]] && [[ "${unit#omp-runner-}" =~ $unit_id_re ]] \
    || refuse "unité de runner invalide : $5"
  [ "$6" = "--quiet" ] || refuse "--quiet attendu (reçu $6)"
  [ "$7" = "--slice=$RUNNER_SLICE" ] || refuse "tranche de runner invalide : $7"
  # Exactement WORKTREES_ROOT/<dépôt>/<feature>, canonique (un audit : `_audit-<id>`).
  cwd="${8#--working-directory=}"
  [ "$8" = "--working-directory=$cwd" ] && [[ "$cwd" =~ $path_re ]] || refuse "répertoire illisible : $8"
  rel="${cwd#"$WORKTREES_ROOT"/}"
  repo="${rel%%/*}"
  feature="${rel#*/}"
  [ "$rel" != "$cwd" ] && [ "$repo" != "$rel" ] && [[ "$repo" =~ $name_re ]] && [[ "$feature" =~ $feature_re ]] \
    || refuse "répertoire hors des worktrees : $8"
  [ "$(canon "$cwd")" = "$(canon "$WORKTREES_ROOT")/$rel" ] || refuse "répertoire non canonique : $8"
  [ "$9" = "-p" ] || refuse "propriété attendue"
  memory="${10#MemoryMax=}"
  [ "${10}" = "MemoryMax=$memory" ] && [[ "$memory" =~ $size_re ]] || refuse "MemoryMax invalide : ${10}"
  [ "${11}" = "-p" ] || refuse "propriété attendue"
  oom="${12#OOMScoreAdjust=}"
  [ "${12}" = "OOMScoreAdjust=$oom" ] && [[ "$oom" =~ ^[0-9]+$ ]] && [ "$oom" -le 1000 ] \
    || refuse "OOMScoreAdjust invalide : ${12}"
  shift 12
  # Le clone du dépôt (le gitdir du worktree y vit) : rendu visible EN LECTURE. Sous
  # REPOS_ROOT, c'est exactement REPOS_ROOT/<dépôt> ; ailleurs, il est déjà visible en
  # lecture seule (ProtectSystem=strict) et rien n'est à monter.
  clone=""
  if [ "${1:-}" = "-p" ] && [[ "${2:-}" == BindReadOnlyPaths=* ]]; then
    clone="${2#BindReadOnlyPaths=}"
    [[ "$clone" =~ $path_re ]] || refuse "clone illisible : $2"
    # Lexicalement canonique, où qu'il soit : ni `.`, ni `..`, ni `//`, ni `/` final.
    if [[ "$clone" =~ (^|/)\.\.?(/|$) ]] || [[ "$clone" == *//* ]] || [[ "$clone" == */ ]]; then
      refuse "clone non canonique : $2"
    fi
    if within "$clone" "$WORKTREES_ROOT"; then refuse "clone dans les worktrees : $2"; fi
    if within "$clone" "$REPOS_ROOT"; then
      crel="${clone#"$REPOS_ROOT"/}"
      [ "$crel" != "$clone" ] && [[ "$crel" =~ $name_re ]] || refuse "clone hors de REPOS_ROOT/<dépôt> : $2"
      [ "$(canon "$clone")" = "$(canon "$REPOS_ROOT")/$crel" ] || refuse "clone non canonique : $2"
    else
      clone=""
    fi
    shift 2
  fi
  # La mémoire du projet du runner : quatre variables, liste FERMÉE, valeurs simples.
  memory_env=()
  while [ "$#" -gt 0 ] && [[ "$1" == --setenv=* ]]; do
    assignment="${1#--setenv=}"
    name="${assignment%%=*}"
    value="${assignment#*=}"
    case "$name" in MEM0_PROJECT_ID | MEM0_AUTOSETUP | MEM0_NUDGE | MEM0_MODE) ;; *) refuse "variable de runner non permise : $name" ;; esac
    [[ "$value" =~ ^[A-Za-z0-9@._/-]{1,128}$ ]] || refuse "valeur invalide pour $name"
    memory_env+=("$name=$value")
    shift
  done
  [ "${1:-}" = "--" ] || refuse "-- attendu avant $OMP_BIN"
  shift
  [ "${1:-}" = "$OMP_BIN" ] || refuse "le runner doit être $OMP_BIN (reçu ${1:-rien})"
  home=$(getent passwd "$RUNNER_USER" | cut -d: -f6 || true)
  [ -n "$home" ] || [ "$DRY_RUN" = "1" ] || refuse "user de runner inconnu : $RUNNER_USER"
  HOME="${home:-/nonexistent}"

  # Le fichier d'environnement ; en essai, dans un dossier jetable, imprimé (`envfile:`) puis effacé.
  if [ "$DRY_RUN" = "1" ]; then
    env_dir=$(mktemp -d)
    trap 'rm -rf -- "$env_dir"' EXIT
  else
    env_dir="$RUNNER_ENV_DIR"
    install -d -m 0700 -o root -g root -- "$env_dir"
    # systemd ne lit le fichier qu'au démarrage du runner : quelques minutes après, il ne sert plus.
    find "$env_dir" -maxdepth 1 -type f -name 'omp-runner-*.env*' -mmin +5 -delete 2>/dev/null || true
  fi
  env_file="$env_dir/$unit.env"
  env_tmp="$env_file.tmp"
  (umask 077 && : > "$env_tmp")
  # Le PATH du lanceur : celui qu'un runner avait sous une scope.
  printf 'PATH=%s\n' "$(env_value "$PATH")" >> "$env_tmp"
  # Les clés des fournisseurs LLM et l'adresse de la mémoire : lues (jamais sourcées)
  # dans un fichier root, pour le runner seul.
  if [ -r "$RUNNER_ENV_FILE" ]; then
    while IFS= read -r line; do
      [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
      case "${BASH_REMATCH[1]}" in BASH_ENV | ENV | LD_* | PATH | HOME | USER | LOGNAME | SHELL) continue ;; esac
      key="${BASH_REMATCH[1]}"
      if quoted=$(env_value "${BASH_REMATCH[2]}"); then
        printf '%s=%s\n' "$key" "$quoted" >> "$env_tmp"
      else
        echo "omp-harness-systemd-run : $key de $RUNNER_ENV_FILE ignorée (guillemet, \\, \$ ou accent grave)" >&2
      fi
    done < "$RUNNER_ENV_FILE"
  fi
  # Les clés déclarées par l'API : seulement des `*_API_KEY` aux valeurs simples. Elles
  # passent après runner.env et l'emportent (root garde la main sur tout le reste).
  if service_file "$PROVIDERS_ENV_FILE"; then
    while IFS= read -r line; do
      # 8 à 512 caractères ; la borne haute hors du motif : le regex BSD refuse `{8,512}` (RE_DUP_MAX 255).
      [[ "$line" =~ ^([A-Z][A-Z0-9_]*_API_KEY)=([A-Za-z0-9._~+/=:-]{8,})$ ]] && [ "${#BASH_REMATCH[2]}" -le 512 ] || continue
      printf "%s='%s'\n" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" >> "$env_tmp"
      if [ "$DRY_RUN" = "1" ]; then printf 'providerenv:%s\n' "${BASH_REMATCH[1]}"; fi
    done < "$PROVIDERS_ENV_FILE"
  fi
  # Le models.yml des fournisseurs compatibles, posé sous le profil du runner, ÉCRIT PAR
  # le runner lui-même (runuser) : root n'écrit jamais dans un HOME qui ne lui est pas.
  profile=""
  previous=""
  for arg in "$@"; do
    if [ "$previous" = "--profile" ]; then profile="$arg"; fi
    previous="$arg"
  done
  if [ -n "$profile" ] && service_file "$PROVIDERS_MODELS_FILE"; then
    [[ "$profile" =~ $unit_id_re ]] || refuse "profil invalide : $profile"
    models_dir="$HOME/.omp/profiles/$profile/agent"
    if [ "$DRY_RUN" = "1" ]; then
      printf 'models:%s\n' "$models_dir/models.yml"
    else
      runuser -u "$RUNNER_USER" -- /bin/sh -c 'umask 077 && mkdir -p -- "$1" && cat > "$1/models.yml.tmp" && mv -f -- "$1/models.yml.tmp" "$1/models.yml"' \
        sh "$models_dir" < "$PROVIDERS_MODELS_FILE" || refuse "models.yml du runner non posé"
    fi
  fi
  # La scope du run passe en dernier : elle vaut pour ce run, pas pour tous.
  for assignment in "${memory_env[@]}"; do
    printf "%s='%s'\n" "${assignment%%=*}" "${assignment#*=}" >> "$env_tmp"
    # `if` et non `&&` : sous `set -e`, une boucle dont la dernière commande échoue arrêterait le lanceur.
    if [ "$DRY_RUN" = "1" ]; then printf 'env:%s\n' "$assignment"; fi
  done
  mv -f -- "$env_tmp" "$env_file"
  if [ "$DRY_RUN" = "1" ]; then
    while IFS= read -r line; do printf 'envfile:%s\n' "$line"; done < "$env_file"
  fi

  # Imposé par le lanceur, jamais par l'appelant : l'user, le bac à sable, ce qui est masqué.
  hidden=()
  for path in $RUNNER_HIDDEN; do hidden+=("-$path"); done
  sandbox=(-p "User=$RUNNER_USER" -p "Group=$WORK_GROUP" -p "UMask=0002"
    -p "NoNewPrivileges=yes" -p "PrivateTmp=yes" -p "PrivateDevices=yes"
    -p "ProtectSystem=strict" -p "ProtectHome=yes" -p "ProtectKernelTunables=yes"
    -p "ProtectKernelModules=yes" -p "ProtectControlGroups=yes"
    -p "TemporaryFileSystem=$WORKTREES_ROOT:ro $REPOS_ROOT:ro" -p "BindPaths=$cwd")
  if [ -n "$clone" ]; then sandbox+=(-p "BindReadOnlyPaths=$clone"); fi
  sandbox+=(-p "ReadWritePaths=-$HOME" -p "InaccessiblePaths=${hidden[*]}" -p "EnvironmentFile=$env_file")
  run systemd-run --wait --pipe --collect --service-type=exec "--unit=$unit" --quiet "--slice=$RUNNER_SLICE" \
    "--working-directory=$cwd" -p "MemoryMax=$memory" -p "OOMScoreAdjust=$oom" "${sandbox[@]}" -- "$@"
}

[ "$#" -ge 1 ] || refuse "aucun argument"

case "$1" in
  --stop)
    [ "$#" -eq 2 ] || refuse "--stop prend une unité"
    [[ "$2" =~ ^omp-(runner|heavy)-[A-Za-z0-9_-]+\.(scope|service)$ ]] || refuse "unité hors du harness : $2"
    run systemctl stop -- "$2"
    ;;

  --wait)
    # Un runner (son unité le dit) : sa forme propre, validée à part.
    if [[ "${5:-}" == --unit=omp-runner-* ]]; then launch_runner "$@"; fi
    # Un job heavy : chaque mot est vérifié jusqu'à `--`, puis exactement HEAVY_SHELL -c CMD.
    final=()
    seen_user=0 seen_network=0 seen_memory=0 seen_nnp=0 seen_unit=0 seen_slice=0 seen_cwd=0
    seen_protect=0 seen_tmp=0 seen_runtime=0
    expected_flags=(--wait --pipe --collect --service-type=exec)
    for flag in "${expected_flags[@]}"; do
      [ "${1:-}" = "$flag" ] || refuse "option attendue : $flag (reçu ${1:-rien})"
      final+=("$1")
      shift
    done
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
      arg="$1"
      shift
      case "$arg" in
        --unit=omp-heavy-*)
          [[ "${arg#--unit=omp-heavy-}" =~ $unit_id_re ]] || refuse "unité heavy invalide : $arg"
          seen_unit=1
          final+=("$arg")
          ;;
        --slice=*)
          [ "$arg" = "--slice=$HEAVY_SLICE" ] || refuse "tranche heavy invalide : $arg"
          seen_slice=1
          final+=("$arg")
          ;;
        --working-directory=*)
          # Exactement WORKTREES_ROOT/<dépôt>/<feature> : ni plus haut, ni plus bas.
          cwd="${arg#--working-directory=}"
          [[ "$cwd" =~ $path_re ]] || refuse "répertoire illisible : $arg"
          rel="${cwd#"$WORKTREES_ROOT"/}"
          [ "$rel" != "$cwd" ] && [ "${rel%%/*}" != "$rel" ] || refuse "répertoire hors des worktrees : $arg"
          [[ "${rel%%/*}" =~ $name_re ]] && [[ "${rel#*/}" =~ $name_re ]] || refuse "répertoire hors des worktrees : $arg"
          # Canonique SOUS la racine : ni `.`/`..`/`//`, ni lien dans <dépôt>/<feature>
          # (la racine, configurée par root, est résolue des deux côtés : /var est un
          # lien sur macOS, où tournent les tests).
          [ "$(canon "$cwd")" = "$(canon "$WORKTREES_ROOT")/$rel" ] || refuse "répertoire non canonique : $arg"
          seen_cwd=1
          final+=("$arg")
          ;;
        --setenv=*)
          [[ "${arg#--setenv=}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || refuse "variable invalide : $arg"
          final+=("$arg")
          ;;
        -p)
          [ "$#" -ge 1 ] || refuse "-p sans propriété"
          prop="$1"
          shift
          key="${prop%%=*}"
          value="${prop#*=}"
          case "$key" in
            MemoryMax) [[ "$value" =~ $size_re ]] || refuse "MemoryMax invalide : $value"; seen_memory=1 ;;
            CPUQuota) [[ "$value" =~ ^[0-9]+%$ ]] || refuse "CPUQuota invalide : $value" ;;
            User) [ "$value" = "$HEAVY_USER" ] || refuse "User doit être $HEAVY_USER (reçu $value)"; seen_user=1 ;;
            PrivateNetwork) [ "$value" = "yes" ] || refuse "PrivateNetwork doit être yes"; seen_network=1 ;;
            OOMScoreAdjust) [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -le 1000 ] || refuse "OOMScoreAdjust doit être entre 0 et 1000" ;;
            RuntimeMaxSec) [[ "$value" =~ ^[1-9][0-9]*$ ]] || refuse "RuntimeMaxSec invalide : $value"; seen_runtime=1 ;;
            NoNewPrivileges) [ "$value" = "yes" ] || refuse "NoNewPrivileges doit être yes"; seen_nnp=1 ;;
            PrivateTmp) [ "$value" = "yes" ] || refuse "PrivateTmp doit être yes"; seen_tmp=1 ;;
            ProtectSystem) [ "$value" = "strict" ] || refuse "ProtectSystem doit être strict"; seen_protect=1 ;;
            UMask) [[ "$value" =~ ^0[0-7]{3}$ ]] || refuse "UMask invalide : $value" ;;
            ReadWritePaths)
              # `set -f` : aucun joker n'est développé ; chaque mot doit être un chemin absolu simple.
              for writable in $value; do
                [[ "$writable" =~ $path_re ]] || refuse "chemin inscriptible illisible : $writable"
                # shellcheck disable=SC2086
                within "$writable" $WRITABLE_ROOTS || refuse "chemin inscriptible hors des racines : $writable"
              done
              ;;
            *) refuse "propriété non permise : $key" ;;
          esac
          final+=(-p "$prop")
          ;;
        *) refuse "option non permise : $arg" ;;
      esac
    done
    [ "$seen_user" = 1 ] && [ "$seen_network" = 1 ] && [ "$seen_memory" = 1 ] && [ "$seen_nnp" = 1 ] || refuse "User, PrivateNetwork, MemoryMax et NoNewPrivileges sont obligatoires"
    [ "$seen_protect" = 1 ] && [ "$seen_tmp" = 1 ] && [ "$seen_runtime" = 1 ] || refuse "ProtectSystem=strict, PrivateTmp et RuntimeMaxSec sont obligatoires"
    [ "$seen_unit" = 1 ] && [ "$seen_slice" = 1 ] && [ "$seen_cwd" = 1 ] || refuse "--unit, --slice et --working-directory sont obligatoires"
    # Imposé par le lanceur, jamais par l'appelant : pas de HOME des autres, ni état du service, ni sockets d'hôte.
    hidden=()
    for path in $HEAVY_HIDDEN; do hidden+=("-$path"); done
    final+=(-p "ProtectHome=yes" -p "InaccessiblePaths=${hidden[*]}" -p "PrivateDevices=yes" -p "PrivateIPC=yes")
    [ "${1:-}" = "--" ] && [ "${2:-}" = "$HEAVY_SHELL" ] && [ "${3:-}" = "-c" ] && [ "$#" -eq 4 ] || refuse "la commande doit être exactement -- $HEAVY_SHELL -c CMD"
    run systemd-run "${final[@]}" -- "$HEAVY_SHELL" -c "$4"
    ;;

  *)
    refuse "forme inconnue : $1"
    ;;
esac
