#!/bin/bash
# Le lanceur ROOT du harness : la seule porte de `omp-harness` vers systemd.
#
# Installé en /usr/local/libexec/omp-harness-systemd-run (root:root 0755) et
# autorisé par sudoers pour le seul user `omp-harness`, SANS SETENV : sudo remet
# l'environnement à zéro (ni BASH_ENV, ni LD_*, ni PATH de l'appelant). Il n'exécute que les TROIS
# lignes que le service construit, après les avoir validées mot à mot :
#
#   --scope …  -- choom -n N -- OMP_BIN … un runner : scope MemoryMax, relancé sous
#                                        RUNNER_USER (jamais root, jamais le service),
#                                        avec les clés de RUNNER_ENV_FILE (root seul)
#                                        puis celles déclarées par l'API (*_API_KEY)
#   --wait --pipe …  -- HEAVY_SHELL -c CMD un job heavy : service transitoire forcé
#                                        User=HEAVY_USER, PrivateNetwork=yes,
#                                        chemins inscriptibles sous WRITABLE_ROOTS
#   --stop omp-(runner|heavy)-….scope|service
#
# Toute autre forme est refusée (sortie 64). Sans ce contrôle, autoriser
# `systemd-run` à `omp-harness` reviendrait à lui donner root (`-p User=root`).
#
# La configuration (/etc/omp-harness/launcher.conf, root:root 0644) est LUE, jamais
# sourcée : seules les clés connues sont prises. OMP_HARNESS_LAUNCHER_DRY_RUN=1
# imprime la ligne finale au lieu de l'exécuter (tests) ; la configuration de
# remplacement OMP_HARNESS_LAUNCHER_CONF n'est honorée qu'en essai ET hors root.
set -euo pipefail
set -f
umask 0002
# /run/current-system/sw/bin : les outils du système sous NixOS (absent ailleurs).
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/run/current-system/sw/bin
export PATH
cd /

WORKTREES_ROOT=/var/lib/omp-harness/worktrees
WRITABLE_ROOTS="/var/lib/omp-harness/worktrees /var/cache/omp-harness /var/lib/omp-heavy"
HEAVY_USER=omp-heavy
RUNNER_USER=omp-runner
WORK_GROUP=omp-work
HEAVY_SLICE=omp-harness-heavy.slice
RUNNER_SLICE=omp-harness-runners.slice
OMP_BIN=/usr/local/bin/omp
RUNNER_ENV_FILE=/etc/omp-harness/runner.env
# Les fournisseurs déclarés par l'API (écrits par le service, pas par root) : leurs clés
# et le models.yml des fournisseurs compatibles OpenAI.
PROVIDERS_ENV_FILE=/var/lib/omp-harness/state/providers.env
PROVIDERS_MODELS_FILE=/var/lib/omp-harness/state/providers.models.yml
# Le bash des jobs heavy : `/bin/bash`, ou son chemin du store sous NixOS.
HEAVY_SHELL=/bin/bash
# Ce qu'un job heavy ne doit jamais voir, ajouté par le lanceur lui-même.
HEAVY_HIDDEN="/var/lib/omp-runner /var/lib/omp-harness/state /var/lib/omp-mem0 /etc/omp-harness /run/dbus /run/docker.sock /var/run/docker.sock /run/systemd/private"

DRY_RUN=0
CONF=/etc/omp-harness/launcher.conf
if [ "${OMP_HARNESS_LAUNCHER_DRY_RUN:-}" = "1" ]; then
  DRY_RUN=1
  if [ "$(id -u)" != "0" ] && [ -n "${OMP_HARNESS_LAUNCHER_CONF:-}" ]; then CONF="$OMP_HARNESS_LAUNCHER_CONF"; fi
fi

if [ -r "$CONF" ]; then
  while IFS='=' read -r key value; do
    case "$key" in
      WORKTREES_ROOT) WORKTREES_ROOT="$value" ;;
      WRITABLE_ROOTS) WRITABLE_ROOTS="$value" ;;
      HEAVY_USER) HEAVY_USER="$value" ;;
      RUNNER_USER) RUNNER_USER="$value" ;;
      WORK_GROUP) WORK_GROUP="$value" ;;
      HEAVY_SLICE) HEAVY_SLICE="$value" ;;
      RUNNER_SLICE) RUNNER_SLICE="$value" ;;
      OMP_BIN) OMP_BIN="$value" ;;
      RUNNER_ENV_FILE) RUNNER_ENV_FILE="$value" ;;
      PROVIDERS_ENV_FILE) PROVIDERS_ENV_FILE="$value" ;;
      PROVIDERS_MODELS_FILE) PROVIDERS_MODELS_FILE="$value" ;;
      HEAVY_HIDDEN) HEAVY_HIDDEN="$value" ;;
      HEAVY_SHELL) HEAVY_SHELL="$value" ;;
      *) ;;
    esac
  done < <(grep -E '^[A-Z_]+=' "$CONF" | sed 's/"//g')
fi

refuse() {
  echo "omp-harness-systemd-run : refusé — $*" >&2
  exit 64
}

# `path` est-il STRICTEMENT sous une des racines données (liens résolus) ?
under() {
  local target root resolved
  target=$(realpath -m -- "$1")
  shift
  for root in "$@"; do
    resolved=$(realpath -m -- "$root")
    case "$target" in "$resolved"/?*) return 0 ;; esac
  done
  return 1
}

# `path` est-il une des racines, ou dessous ?
within() {
  local target root resolved
  target=$(realpath -m -- "$1")
  shift
  for root in "$@"; do
    resolved=$(realpath -m -- "$root")
    [ "$target" = "$resolved" ] && return 0
    case "$target" in "$resolved"/?*) return 0 ;; esac
  done
  return 1
}

# Un fichier écrit par le service : régulier, pas un lien, et pas à root (avec
# fs.protected_hardlinks, un lien dur vers un fichier de root garde root pour
# propriétaire). Sans ce contrôle, le service ferait lire n'importe quel fichier à root.
service_file() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ "$(stat -c %u -- "$1")" != "0" ]
}

run() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '%s\n' "$@"
    exit 0
  fi
  exec "$@"
}

size_re='^[0-9]+[KMGT]?$'
unit_id_re='^[A-Za-z0-9_-]+$'
# Un chemin que systemd et bash lisent pareil : absolu, sans espace, guillemet, joker, %, préfixe - ou +.
path_re='^/[A-Za-z0-9._/-]+$'
name_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'

[ "$#" -ge 1 ] || refuse "aucun argument"

case "$1" in
  --stop)
    [ "$#" -eq 2 ] || refuse "--stop prend une unité"
    [[ "$2" =~ ^omp-(runner|heavy)-[A-Za-z0-9_-]+\.(scope|service)$ ]] || refuse "unité hors du harness : $2"
    run systemctl stop -- "$2"
    ;;

  --scope)
    # --scope --quiet --collect --unit=omp-runner-ID --slice=… -p MemoryMax=X
    #   [--setenv=MEM0_PROJECT_ID|MEM0_AUTOSETUP|MEM0_NUDGE=…]… -- choom -n N -- OMP_BIN …
    [ "$#" -ge 12 ] || refuse "ligne de runner trop courte"
    [ "$2" = "--quiet" ] && [ "$3" = "--collect" ] || refuse "options de scope inattendues"
    unit="${4#--unit=}"
    [ "$4" = "--unit=$unit" ] && [[ "$unit" =~ ^omp-runner- ]] && [[ "${unit#omp-runner-}" =~ $unit_id_re ]] || refuse "unité de runner invalide : $4"
    [ "$5" = "--slice=$RUNNER_SLICE" ] || refuse "tranche de runner invalide : $5"
    [ "$6" = "-p" ] || refuse "propriété attendue"
    memory="${7#MemoryMax=}"
    [ "$7" = "MemoryMax=$memory" ] && [[ "$memory" =~ $size_re ]] || refuse "MemoryMax invalide : $7"
    shift 7
    # La mémoire du projet du runner : trois variables, liste FERMÉE, valeurs simples.
    memory_env=()
    while [ "$#" -gt 0 ] && [[ "$1" == --setenv=* ]]; do
      assignment="${1#--setenv=}"
      name="${assignment%%=*}"
      value="${assignment#*=}"
      case "$name" in MEM0_PROJECT_ID | MEM0_AUTOSETUP | MEM0_NUDGE) ;; *) refuse "variable de runner non permise : $name" ;; esac
      [[ "$value" =~ ^[A-Za-z0-9@._/-]{1,128}$ ]] || refuse "valeur invalide pour $name"
      memory_env+=("$name=$value")
      shift
    done
    [ "${1:-}" = "--" ] && [ "${2:-}" = "choom" ] && [ "${3:-}" = "-n" ] || refuse "le runner doit passer par choom"
    [[ "${4:-}" =~ ^[0-9]+$ ]] && [ "$4" -le 1000 ] || refuse "score OOM invalide : ${4:-rien}"
    [ "${5:-}" = "--" ] || refuse "choom -n N -- attendu"
    oom="$4"
    shift 5
    [ "${1:-}" = "$OMP_BIN" ] || refuse "le runner doit être $OMP_BIN (reçu ${1:-rien})"
    home=$(getent passwd "$RUNNER_USER" | cut -d: -f6 || true)
    [ -n "$home" ] || [ "$DRY_RUN" = "1" ] || refuse "user de runner inconnu : $RUNNER_USER"
    export HOME="${home:-/nonexistent}" USER="$RUNNER_USER" LOGNAME="$RUNNER_USER"
    # Les clés des fournisseurs LLM et l'adresse de la mémoire : lues (jamais sourcées)
    # dans un fichier root, pour le runner seul.
    if [ -r "$RUNNER_ENV_FILE" ]; then
      while IFS= read -r line; do
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
        case "${BASH_REMATCH[1]}" in BASH_ENV | ENV | LD_* | PATH | HOME | USER | LOGNAME | SHELL) continue ;; esac
        export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
      done < "$RUNNER_ENV_FILE"
    fi
    # Les clés déclarées par l'API : seulement des `*_API_KEY` aux valeurs simples. Elles
    # passent après runner.env et l'emportent (root garde la main sur tout le reste).
    if service_file "$PROVIDERS_ENV_FILE"; then
      while IFS= read -r line; do
        [[ "$line" =~ ^([A-Z][A-Z0-9_]*_API_KEY)=([A-Za-z0-9._~+/=:-]{8,512})$ ]] || continue
        export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
        if [ "$DRY_RUN" = "1" ]; then printf 'providerenv:%s\n' "${BASH_REMATCH[1]}"; fi
      done < "$PROVIDERS_ENV_FILE"
    fi
    # Le models.yml des fournisseurs compatibles, posé sous le profil du runner, ÉCRIT PAR
    # le runner lui-même (runuser) : root n'écrit jamais dans un HOME qui ne lui est pas.
    profile=""
    previous=""
    for arg in "$@"; do
      if [ "$previous" = "--profile" ]; then profile="$arg"; fi
      previous="$arg"
    done
    if [ -n "$profile" ] && service_file "$PROVIDERS_MODELS_FILE"; then
      [[ "$profile" =~ $unit_id_re ]] || refuse "profil invalide : $profile"
      models_dir="$HOME/.omp/profiles/$profile/agent"
      if [ "$DRY_RUN" = "1" ]; then
        printf 'models:%s\n' "$models_dir/models.yml"
      else
        runuser -u "$RUNNER_USER" -- /bin/sh -c 'umask 077 && mkdir -p -- "$1" && cat > "$1/models.yml.tmp" && mv -f -- "$1/models.yml.tmp" "$1/models.yml"' \
          sh "$models_dir" < "$PROVIDERS_MODELS_FILE" || refuse "models.yml du runner non posé"
      fi
    fi
    # La scope du run passe APRÈS runner.env : elle vaut pour ce run, pas pour tous.
    for assignment in "${memory_env[@]}"; do
      export "${assignment?}"
      # `if` et non `&&` : sous `set -e`, une boucle dont la dernière commande échoue arrêterait le lanceur.
      if [ "$DRY_RUN" = "1" ]; then printf 'env:%s\n' "$assignment"; fi
    done
    run systemd-run --scope --quiet --collect "--unit=$unit" "--slice=$RUNNER_SLICE" -p "MemoryMax=$memory" \
      "--uid=$RUNNER_USER" "--gid=$WORK_GROUP" -- choom -n "$oom" -- "$@"
    ;;

  --wait)
    # Un job heavy : chaque mot est vérifié jusqu'à `--`, puis exactement HEAVY_SHELL -c CMD.
    final=()
    seen_user=0 seen_network=0 seen_memory=0 seen_nnp=0 seen_unit=0 seen_slice=0 seen_cwd=0
    seen_protect=0 seen_tmp=0 seen_runtime=0
    expected_flags=(--wait --pipe --collect --service-type=exec)
    for flag in "${expected_flags[@]}"; do
      [ "${1:-}" = "$flag" ] || refuse "option attendue : $flag (reçu ${1:-rien})"
      final+=("$1")
      shift
    done
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
      arg="$1"
      shift
      case "$arg" in
        --unit=omp-heavy-*)
          [[ "${arg#--unit=omp-heavy-}" =~ $unit_id_re ]] || refuse "unité heavy invalide : $arg"
          seen_unit=1
          final+=("$arg")
          ;;
        --slice=*)
          [ "$arg" = "--slice=$HEAVY_SLICE" ] || refuse "tranche heavy invalide : $arg"
          seen_slice=1
          final+=("$arg")
          ;;
        --working-directory=*)
          # Exactement WORKTREES_ROOT/<dépôt>/<feature> : ni plus haut, ni plus bas.
          cwd="${arg#--working-directory=}"
          [[ "$cwd" =~ $path_re ]] || refuse "répertoire illisible : $arg"
          rel="${cwd#"$WORKTREES_ROOT"/}"
          [ "$rel" != "$cwd" ] && [ "${rel%%/*}" != "$rel" ] || refuse "répertoire hors des worktrees : $arg"
          [[ "${rel%%/*}" =~ $name_re ]] && [[ "${rel#*/}" =~ $name_re ]] || refuse "répertoire hors des worktrees : $arg"
          [ "$(realpath -m -- "$cwd")" = "$cwd" ] || refuse "répertoire non canonique : $arg"
          seen_cwd=1
          final+=("$arg")
          ;;
        --setenv=*)
          [[ "${arg#--setenv=}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || refuse "variable invalide : $arg"
          final+=("$arg")
          ;;
        -p)
          [ "$#" -ge 1 ] || refuse "-p sans propriété"
          prop="$1"
          shift
          key="${prop%%=*}"
          value="${prop#*=}"
          case "$key" in
            MemoryMax) [[ "$value" =~ $size_re ]] || refuse "MemoryMax invalide : $value"; seen_memory=1 ;;
            CPUQuota) [[ "$value" =~ ^[0-9]+%$ ]] || refuse "CPUQuota invalide : $value" ;;
            User) [ "$value" = "$HEAVY_USER" ] || refuse "User doit être $HEAVY_USER (reçu $value)"; seen_user=1 ;;
            PrivateNetwork) [ "$value" = "yes" ] || refuse "PrivateNetwork doit être yes"; seen_network=1 ;;
            OOMScoreAdjust) [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -le 1000 ] || refuse "OOMScoreAdjust doit être entre 0 et 1000" ;;
            RuntimeMaxSec) [[ "$value" =~ ^[1-9][0-9]*$ ]] || refuse "RuntimeMaxSec invalide : $value"; seen_runtime=1 ;;
            NoNewPrivileges) [ "$value" = "yes" ] || refuse "NoNewPrivileges doit être yes"; seen_nnp=1 ;;
            PrivateTmp) [ "$value" = "yes" ] || refuse "PrivateTmp doit être yes"; seen_tmp=1 ;;
            ProtectSystem) [ "$value" = "strict" ] || refuse "ProtectSystem doit être strict"; seen_protect=1 ;;
            UMask) [[ "$value" =~ ^0[0-7]{3}$ ]] || refuse "UMask invalide : $value" ;;
            ReadWritePaths)
              # `set -f` : aucun joker n'est développé ; chaque mot doit être un chemin absolu simple.
              for writable in $value; do
                [[ "$writable" =~ $path_re ]] || refuse "chemin inscriptible illisible : $writable"
                # shellcheck disable=SC2086
                within "$writable" $WRITABLE_ROOTS || refuse "chemin inscriptible hors des racines : $writable"
              done
              ;;
            *) refuse "propriété non permise : $key" ;;
          esac
          final+=(-p "$prop")
          ;;
        *) refuse "option non permise : $arg" ;;
      esac
    done
    [ "$seen_user" = 1 ] && [ "$seen_network" = 1 ] && [ "$seen_memory" = 1 ] && [ "$seen_nnp" = 1 ] || refuse "User, PrivateNetwork, MemoryMax et NoNewPrivileges sont obligatoires"
    [ "$seen_protect" = 1 ] && [ "$seen_tmp" = 1 ] && [ "$seen_runtime" = 1 ] || refuse "ProtectSystem=strict, PrivateTmp et RuntimeMaxSec sont obligatoires"
    [ "$seen_unit" = 1 ] && [ "$seen_slice" = 1 ] && [ "$seen_cwd" = 1 ] || refuse "--unit, --slice et --working-directory sont obligatoires"
    # Imposé par le lanceur, jamais par l'appelant : pas de HOME des autres, ni état du service, ni sockets d'hôte.
    hidden=()
    for path in $HEAVY_HIDDEN; do hidden+=("-$path"); done
    final+=(-p "ProtectHome=yes" -p "InaccessiblePaths=${hidden[*]}" -p "PrivateDevices=yes" -p "PrivateIPC=yes")
    [ "${1:-}" = "--" ] && [ "${2:-}" = "$HEAVY_SHELL" ] && [ "${3:-}" = "-c" ] && [ "$#" -eq 4 ] || refuse "la commande doit être exactement -- $HEAVY_SHELL -c CMD"
    run systemd-run "${final[@]}" -- "$HEAVY_SHELL" -c "$4"
    ;;

  *)
    refuse "forme inconnue : $1"
    ;;
esac
