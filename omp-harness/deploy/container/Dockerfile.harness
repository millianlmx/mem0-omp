# Le service du harness en conteneur. Il ne lance rien lui-même : chaque runner et
# chaque job de tests est un conteneur FRÈRE, par le socket du moteur monté dans
# /var/run/docker.sock (Docker, ou l'API compatible de podman). Construit depuis la
# racine du dépôt : voir compose.yaml.
ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim
ARG DOCKER_CLI_IMAGE=docker.io/library/docker:29-cli
FROM ${DOCKER_CLI_IMAGE} AS cli

FROM ${NODE_IMAGE} AS base
# Les paquets absents de l'image de base, et eux seuls (`gh` sert la forge GitHub : PR de
# `"merge": "gh"`, issues).
ARG PACKAGES="ca-certificates curl git openssh-client gh"
RUN missing="$(for p in $PACKAGES; do dpkg -s "$p" >/dev/null 2>&1 || echo "$p"; done)"; \
    if [ -n "$missing" ]; then apt-get update && apt-get install -y --no-install-recommends $missing && rm -rf /var/lib/apt/lists/*; fi
# `glab` sert la forge GitLab (MR, issues) : une version épinglée, l'archive vérifiée par
# sa somme SHA-256 (celles de checksums.txt de la release) avant d'être dépaquetée.
ARG GLAB_VERSION=1.128.0
ARG GLAB_SHA256_AMD64=bc024819e7598b19429a199cd87f640d98b2b67416d8ad796f19e4260b57a7c7
ARG GLAB_SHA256_ARM64=60d0512085a8c1be7c5ef51aa7e4ee28213444cea0376b3260707d90489199ea
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) sum="$GLAB_SHA256_AMD64" ;; \
      arm64) sum="$GLAB_SHA256_ARM64" ;; \
      *) echo "glab : architecture $arch non prise en charge" >&2; exit 1 ;; \
    esac; \
    file="glab_${GLAB_VERSION}_linux_${arch}.tar.gz"; \
    curl -fsSL -o "/tmp/$file" \
      "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/$file"; \
    echo "$sum  /tmp/$file" | sha256sum -c -; \
    tar -xzf "/tmp/$file" -C /usr/local bin/glab; \
    rm "/tmp/$file"; \
    glab --version

# Le commit construit (build-commit) : l'argument, sinon le .git du contexte, sinon le
# tag de la version prouvé par ses arbres. Inconnu, il reste vide : le build continue.
FROM base AS commit
ARG OMP_HARNESS_COMMIT=""
ARG OMP_HARNESS_SOURCE_REPO=""
COPY . /ctx
RUN sh /ctx/omp-harness/deploy/container/build-commit /ctx > /commit || : > /commit

FROM base
# Le seul client du moteur : la CLI Docker, qui parle aussi à l'API de podman.
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY omp-harness /opt/omp-harness/omp-harness
COPY omp-mem0-memory /opt/omp-harness/omp-mem0-memory
COPY omp-harness/deploy/container/omp-harness-check /usr/local/bin/omp-harness-check
COPY omp-harness/deploy/container/harness-entrypoint /usr/local/bin/omp-harness-entrypoint
COPY omp-harness/deploy/container/stack-setup /usr/local/bin/omp-harness-stack
# L'entrée déclare l'uid du lancement (ssh en a besoin) : /etc/passwd lui est ouvert.
RUN chmod o+w /etc/passwd
# Lu par l'entrée en OMP_HARNESS_COMMIT, que /v1/health et le rapport du matin rendent.
COPY --from=commit /commit /opt/omp-harness/commit
ENV DOCKER_HOST=unix:///var/run/docker.sock
EXPOSE 8790
ENTRYPOINT ["/usr/local/bin/omp-harness-entrypoint"]
CMD ["node", "--experimental-strip-types", "--disable-warning=ExperimentalWarning", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "/opt/omp-harness/omp-harness/main.ts", "--config", "/etc/omp-harness/config.json"]
