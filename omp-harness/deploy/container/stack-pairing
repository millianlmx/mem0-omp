#!/bin/sh
# Le code d'appairage de la pile (docker-compose.yml), écrit dans les journaux du
# service `pairing` dès que le harness a son jeton et que Tailscale est connecté. Le
# même code que `harness.sh pair` : `omp1:` puis, en base64url, le harness, son
# jeton, la mémoire et son jeton. Relancer le service le réaffiche.
set -eu

SOCKET="${TS_SOCKET:-/var/run/tailscale/tailscaled.sock}"
TOKEN_FILE="${OMP_HARNESS_TOKEN_FILE:-/state/token}"
MEM0_ENV="${OMP_HARNESS_MEM0_ENV:-/secrets/mem0.env}"
POLL="${OMP_HARNESS_PAIRING_POLL:-5}"

status() { tailscale --socket="$SOCKET" status --json 2>/dev/null || true; }

asked=""
while :; do
  json="$(status)"
  name="$(printf '%s' "$json" | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p' | head -1)"
  if [ -n "$name" ] && [ -s "$TOKEN_FILE" ] && [ -s "$MEM0_ENV" ]; then break; fi
  login="$(printf '%s' "$json" | sed -n 's/.*"AuthURL": *"\(https:[^"]*\)".*/\1/p' | head -1)"
  if [ -n "$login" ] && [ "$login" != "$asked" ]; then
    echo "Connecte le serveur à ton tailnet (ou pose TS_AUTHKEY dans les variables de la pile) :"
    echo "  $login"
    asked="$login"
  fi
  sleep "$POLL"
done

code="$(printf '%s\n%s\n%s\n%s\n' \
  "https://$name" "$(tr -d '\n' < "$TOKEN_FILE")" \
  "https://$name:8443" "$(sed -n 's/^MEM0_HTTP_TOKEN=//p' "$MEM0_ENV" | tail -1)" |
  base64 | tr -d '\n=' | tr '+/' '-_')"
echo "Code d'appairage (secret : il donne accès au harness et à la mémoire) :"
echo
echo "  omp1:$code"
echo
echo "Sur ton Mac : dans omp, /pair omp1:… — ou colle-le dans l'app, feuille Serveur (Mac et iPhone)."
