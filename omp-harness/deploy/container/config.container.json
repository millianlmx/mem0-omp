{
  "listen": { "host": "0.0.0.0", "port": 8790 },
  "tokenFile": "@ROOT@/state/token",
  "dataDir": "@ROOT@/state",
  "worktreesDir": "@ROOT@/worktrees",
  "ompBin": "/usr/local/bin/omp",
  "launcher": [],
  "git": { "authorName": "omp-harness", "authorEmail": "omp-harness@localhost" },
  "runner": {
    "isolation": "container",
    "slots": 5,
    "memoryMax": "1G",
    "extensions": ["/opt/omp-harness/omp-mem0-memory/extension.ts"]
  },
  "heavy": {
    "isolation": "container",
    "slots": 2,
    "memoryMax": "4G",
    "cpuQuota": "300%",
    "cargoTargetRoot": "@ROOT@/cache/cargo",
    "readWritePaths": [],
    "env": {}
  },
  "container": {
    "command": ["docker"],
    "runnerImage": "omp-harness-runner:local",
    "testImage": "docker.io/library/node:22-bookworm",
    "network": "omp-harness",
    "runnerEnvFile": "@SECRETS@/runner.env",
    "runnerHome": "@ROOT@/runner-home"
  },
  "models": {
    "standard": [{ "provider": "anthropic", "model": "claude-sonnet-5-5" }],
    "heavy": [{ "provider": "anthropic", "model": "claude-opus-5-5" }]
  },
  "stepTiers": { "req": "heavy", "specs": "heavy", "impl": "standard", "fix": "standard", "review": "heavy" },
  "providers": { "anthropic": { "capacity": 20, "refillPerMinute": 20 } },
  "review": { "fixCap": 3, "maxDiffLines": 300 },
  "oracle": { "url": "http://mem0:8321", "token": null },
  "repos": []
}
