# La vigie (omp-harness/vigie/) : node pour son process, omp pour ses sessions de tri et
# de pilotage — à la version et aux empreintes épinglées des runners (Dockerfile.runner,
# deploy/install.sh). Ni socket du moteur, ni gh, ni jeton GitHub : tout passe par l'API
# du harness, sous son jeton de client pilote. Construit depuis la racine du dépôt.
ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim
FROM ${NODE_IMAGE}
ARG TARGETARCH
ARG OMP_VERSION=18.6.0
# Les paquets absents de l'image de base, et eux seuls (`git` lit l'historique des clones).
ARG PACKAGES="ca-certificates curl git"
RUN missing="$(for p in $PACKAGES; do dpkg -s "$p" >/dev/null 2>&1 || echo "$p"; done)"; \
    if [ -n "$missing" ]; then apt-get update && apt-get install -y --no-install-recommends $missing && rm -rf /var/lib/apt/lists/*; fi
RUN set -eu; \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) asset=omp-linux-x64; sha=844c640c620ec4c152abe4b3736049f963205da50e9e77bd9bdf2a981a6ead55 ;; \
      arm64) asset=omp-linux-arm64; sha=542083fe42a6169565861a4ee9118fbed64d09c93468b6907e6016cc76ef00d1 ;; \
      *) echo "architecture non prise en charge par omp : ${TARGETARCH:-?}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/can1357/oh-my-pi/releases/download/v${OMP_VERSION}/${asset}" -o /usr/local/bin/omp; \
    echo "${sha}  /usr/local/bin/omp" | sha256sum -c --quiet -; \
    chmod 0755 /usr/local/bin/omp
COPY omp-harness /opt/omp-harness/omp-harness
COPY omp-harness/deploy/container/vigie-entrypoint /usr/local/bin/omp-vigie-entrypoint
# L'entrée déclare l'uid du lancement (git et omp veulent un HOME) : /etc/passwd lui est ouvert.
RUN chmod o+w /etc/passwd
ENTRYPOINT ["/usr/local/bin/omp-vigie-entrypoint"]
CMD ["node", "--experimental-strip-types", "--disable-warning=ExperimentalWarning", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "/opt/omp-harness/omp-harness/vigie/main.ts"]
