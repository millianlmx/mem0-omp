#!/bin/sh
# Le harness déployé sans terminal (Portainer, ou `docker compose up -d` à la racine du
# dépôt) : ce que `harness.sh up` et `harness.sh add` font en interactif, rejoué à
# chaque démarrage de la pile, sans rien perdre. Les réglages viennent des variables
# de la pile (docker-compose.yml) ; le jeton de la mémoire et la clé SSH, eux, ne
# sont créés qu'une fois.
#
#   omp-harness-stack init      dossiers, secrets, config.json, clé SSH, client pilote de la
#                               vigie et ses secrets (service `setup`)
#   omp-harness-stack repos     déclare les dépôts d'OMP_HARNESS_REPOS (service `repos`)
#   omp-harness-stack approver  le code approbateur des apps, à la main dans la console
#                               du conteneur `harness` (comme `harness.sh approver`)
set -eu

ROOT="${OMP_HARNESS_ROOT:?OMP_HARNESS_ROOT manquant}"
SECRETS="${OMP_HARNESS_SECRETS:?OMP_HARNESS_SECRETS manquant}"
TEMPLATE="${OMP_HARNESS_TEMPLATE:-/opt/omp-harness/omp-harness/deploy/container/config.container.json}"
MAIN="${OMP_HARNESS_MAIN:-/opt/omp-harness/omp-harness/main.ts}"
RETRY="${OMP_HARNESS_REPOS_RETRY:-30}"

die() { echo "✗ $*" >&2; exit 1; }
setting() { [ ! -e "$2" ] || sed -n "s/^$1=//p" "$2" | tail -1; }
harness_main() {
  node --experimental-strip-types --disable-warning=ExperimentalWarning \
    --disable-warning=MODULE_TYPELESS_PACKAGE_JSON "$MAIN" --config "$ROOT/config.json" "$@"
}

# Les fichiers .env sont sourcés par les conteneurs : une valeur ne porte que des
# caractères sans effet pour le shell.
check_values() {
  for name in OMLX_BASE_URL OMLX_API_TOKEN OMLX_CHAT_BASE_URL OMLX_CHAT_API_TOKEN OMLX_LLM_MODEL OMLX_EMBED_MODEL EMBEDDING_DIMS \
    ANTHROPIC_API_KEY OPENROUTER_API_KEY GH_TOKEN; do
    eval "value=\${$name:-}"
    case "$value" in
      *[!A-Za-z0-9_.:/~+=@-]*) die "$name porte un caractère refusé (espace, guillemet, \$…) : corrige la variable de la pile" ;;
    esac
  done
  # Les jetons par dépôt (politique par dépôt, forges) : `nom:jeton:scope,…;…` et `nom:jeton;…`.
  for name in OMP_HARNESS_MEMORY_TOKENS OMP_HARNESS_GITHUB_ACCOUNTS OMP_HARNESS_GITLAB_ACCOUNTS; do
    eval "value=\${$name:-}"
    case "$value" in
      *[!A-Za-z0-9_.:/~+=@,\;-]*) die "$name porte un caractère refusé (espace, guillemet, \$…) : corrige la variable de la pile" ;;
    esac
  done
}

# Le nom d'une variable du service pour l'entrée `nom` : PRÉFIXE_NOM, en majuscules.
secret_var() { printf '%s_%s' "$1" "$(printf '%s' "$2" | tr 'a-z.-' 'A-Z__')"; }

# Les jetons d'une liste `nom:jeton[:…];…`, une ligne `PRÉFIXE_NOM=jeton` chacun.
secret_lines() {
  printf '%s\n' "$2" | tr ';' '\n' | while IFS=: read -r name secret _; do
    [ -n "$name" ] && [ -n "$secret" ] || continue
    printf '%s=%s\n' "$(secret_var "$1" "$name")" "$secret"
  done
}

# Les navigateurs Obscura (services `obscura` et `obscura-poste`) : un jeton CDP chacun,
# gardé d'un démarrage à l'autre, dans un fichier sourcé par leur entrée (0600). Le
# stockage du navigateur du poste est inscriptible par l'uid 65532 de l'image. Les deux
# jetons vont aussi, avec les adresses, dans harness.env : le harness est leur seul client.
obscura_secrets() {
  for name in obscura obscura-poste; do
    mkdir -p "$SECRETS/$name"
    chmod 0700 "$SECRETS/$name"
    value="$(setting OBSCURA_CDP_TOKEN "$SECRETS/$name/obscura.env")"
    [ -n "$value" ] || value="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    (umask 077 && printf 'OBSCURA_CDP_TOKEN=%s\n' "$value" > "$SECRETS/$name/obscura.env")
    case "$name" in obscura) obscura_token="$value" ;; *) poste_token="$value" ;; esac
  done
  mkdir -p "$SECRETS/obscura-poste/storage"
  chmod 0700 "$SECRETS/obscura-poste/storage"
  chown -R 65532:65532 "$SECRETS/obscura" "$SECRETS/obscura-poste" 2>/dev/null ||
    echo "· propriétaire 65532 non posé sur les dossiers d'Obscura (setup doit tourner en root)"
}

cmd_init() {
  check_values
  umask 022
  mkdir -p "$ROOT/state" "$ROOT/state/logs" "$ROOT/repos" "$ROOT/worktrees" "$ROOT/home/.ssh" "$ROOT/runner-home" \
    "$ROOT/mem0" "$ROOT/ollama" "$ROOT/cache/cargo" "$ROOT/published" "$ROOT/vigie" \
    "$SECRETS/harness" "$SECRETS/mem0" "$SECRETS/vigie"
  chmod 0700 "$ROOT" "$SECRETS" "$SECRETS/harness" "$SECRETS/mem0" "$SECRETS/vigie" "$ROOT/home/.ssh"

  # Le jeton de la mémoire, partagé par le service, mem0-rs et les runners : gardé.
  token="$(setting MEM0_HTTP_TOKEN "$SECRETS/mem0/mem0.env")"
  [ -n "$token" ] || token="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"

  obscura_secrets

  # Le chat (rêve, add infer=true) suit OMLX_BASE_URL quand elle est donnée ; l'Ollama
  # intégré ne sert que les embeddings : sans serveur de chat, le chat est coupé.
  chat="${OMLX_CHAT_BASE_URL:-}"
  [ -n "$chat" ] || [ -n "${OMLX_BASE_URL:-}" ] || chat=off
  umask 077
  # Le jeton de la mémoire, puis ceux des dépôts (`memory.tokenEnv` : MEM0_TOKEN_<NOM>,
  # `gh.tokenEnv` : GH_TOKEN_<NOM>, `gitlab.tokenEnv` : GITLAB_TOKEN_<NOM>) : le service
  # les passe à SES runners, ou à gh et glab.
  {
    printf 'MEM0_HTTP_TOKEN=%s\n' "$token"
    printf 'OBSCURA_CDP_URL=http://obscura:9222\n'
    printf 'OBSCURA_CDP_TOKEN=%s\n' "$obscura_token"
    printf 'OBSCURA_POSTE_CDP_URL=http://obscura-poste:9222\n'
    printf 'OBSCURA_POSTE_CDP_TOKEN=%s\n' "$poste_token"
    [ -z "${GH_TOKEN:-}" ] || printf 'GH_TOKEN=%s\n' "$GH_TOKEN"
    secret_lines MEM0_TOKEN "${OMP_HARNESS_MEMORY_TOKENS:-}"
    secret_lines GH_TOKEN "${OMP_HARNESS_GITHUB_ACCOUNTS:-}"
    secret_lines GITLAB_TOKEN "${OMP_HARNESS_GITLAB_ACCOUNTS:-}"
  } > "$SECRETS/harness/harness.env"
  {
    printf 'MEM0_HTTP_TOKEN=%s\n' "$token"
    printf 'OMLX_BASE_URL=%s\n' "${OMLX_BASE_URL:-http://embeddings:11434/v1}"
    printf 'OMLX_API_TOKEN=%s\n' "${OMLX_API_TOKEN:-}"
    [ -z "$chat" ] || printf 'OMLX_CHAT_BASE_URL=%s\n' "$chat"
    [ -z "${OMLX_CHAT_API_TOKEN:-}" ] || printf 'OMLX_CHAT_API_TOKEN=%s\n' "$OMLX_CHAT_API_TOKEN"
    printf 'OMLX_LLM_MODEL=%s\n' "${OMLX_LLM_MODEL:-qwen3-8b}"
    printf 'OMLX_EMBED_MODEL=%s\n' "${OMLX_EMBED_MODEL:-bge-m3}"
    printf 'EMBEDDING_DIMS=%s\n' "${EMBEDDING_DIMS:-1024}"
    # Les jetons limités à leurs portées : un fichier (mem0.env est sourcé, `;` y couperait la ligne).
    [ -z "${OMP_HARNESS_MEMORY_TOKENS:-}" ] || printf 'MEM0_HTTP_TOKENS_FILE=/run/secrets/mem0/tokens\n'
  } > "$SECRETS/mem0/mem0.env"
  if [ -n "${OMP_HARNESS_MEMORY_TOKENS:-}" ]; then
    printf '%s\n' "$OMP_HARNESS_MEMORY_TOKENS" | tr ';' '\n' > "$SECRETS/mem0/tokens"
  else
    rm -f "$SECRETS/mem0/tokens"
  fi
  # Les clés LLM ne vont qu'aux runners : le service ne les voit jamais.
  {
    printf 'MEM0_HTTP_TOKEN=%s\n' "$token"
    for name in ANTHROPIC_API_KEY OPENROUTER_API_KEY; do
      eval "value=\${$name:-}"
      [ -z "$value" ] || printf '%s=%s\n' "$name" "$value"
    done
  } > "$SECRETS/runner.env"
  umask 022

  [ -e "$ROOT/config.json" ] ||
    sed -e "s|@ROOT@|$ROOT|g" -e "s|@SECRETS@|$SECRETS|g" "$TEMPLATE" > "$ROOT/config.json"

  if [ ! -e "$ROOT/home/.ssh/id_ed25519" ]; then
    ssh-keygen -q -t ed25519 -N '' -C omp-harness -f "$ROOT/home/.ssh/id_ed25519"
    # Premier contact : la clé d'hôte est retenue ; une clé qui change ensuite est refusée.
    printf 'Host *\n  StrictHostKeyChecking accept-new\n  ConnectTimeout 20\n' > "$ROOT/home/.ssh/config"
    chmod 0600 "$ROOT/home/.ssh/config"
  fi

  vigie_secrets "$token"

  echo "✓ harness prêt dans $ROOT (secrets dans $SECRETS)"
  grep -q '^[A-Z_]*API_KEY=.' "$SECRETS/runner.env" ||
    echo "· Aucune clé de modèle : pose ANTHROPIC_API_KEY dans les variables de la pile, puis redéploie"
  echo "· Chaque dépôt d'OMP_HARNESS_REPOS reçoit sa propre clé de déploiement, affichée par le service repos."
}

# La vigie (service `vigie`) : son client pilote — operator, jamais approbateur — recréé
# s'il a disparu, et ses secrets : son jeton, celui de la mémoire et les clés des modèles
# de ses sessions, jamais GH_TOKEN (les issues passent par le harness, qui les caviarde).
vigie_secrets() {
  if [ ! -r "$MAIN" ]; then
    echo "· La vigie attend son client : $MAIN introuvable"
    return 0
  fi
  vigie="$(setting VIGIE_TOKEN "$SECRETS/vigie/vigie.env")"
  if [ -z "$vigie" ] || ! harness_main --list-clients 2>/dev/null | grep -q "^vigie$(printf '\t').*pilote\$"; then
    harness_main --revoke-client vigie >/dev/null 2>&1 || true
    vigie="$(harness_main --add-client vigie --role operator --pilot 2>/dev/null)" || die "client de la vigie non créé"
  fi
  umask 077
  {
    printf 'VIGIE_TOKEN=%s\n' "$vigie"
    printf 'MEM0_HTTP_TOKEN=%s\n' "$1"
    for name in ANTHROPIC_API_KEY OPENROUTER_API_KEY; do
      eval "value=\${$name:-}"
      [ -z "$value" ] || printf '%s=%s\n' "$name" "$value"
    done
  } > "$SECRETS/vigie/vigie.env"
  umask 022
}

# L'URL SSH d'un dépôt GitHub donné en HTTPS : la clé de déploiement ne sert qu'en SSH.
ssh_url() {
  case "$1" in
    https://github.com/*) path="${1#https://github.com/}"; echo "git@github.com:${path%.git}.git" ;;
    *) echo "$1" ;;
  esac
}

# Chaque dépôt a sa clé (`--add-repo` la crée sous $HOME/.ssh/repos) : GitHub refuse
# une même clé de déploiement sur deux dépôts.
deploy_key_help() {
  name="${1%/}"; name="${name##*[/:]}"; name="${name%.git}"
  echo "  Pose la clé de CE dépôt en clé de déploiement de $1, « Allow write access » cochée :"
  slug="$(printf '%s' "$1" | sed -n 's#^git@github\.com:\(.*\)\.git$#\1#p')"
  [ -z "$slug" ] || echo "  https://github.com/$slug/settings/keys/new"
  echo "  $(cat "$ROOT/home/.ssh/repos/$name.pub")"
}

# Le service relit config.json sans arrêter ses runs (SIGHUP). Il est retrouvé par les
# étiquettes de la pile, quel que soit le nom que Portainer lui a donné.
reload_harness() {
  project="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$(hostname)" 2>/dev/null)" || return 0
  ids="$(docker ps -q --filter "label=com.docker.compose.project=$project" --filter label=com.docker.compose.service=harness)"
  [ -z "$ids" ] || docker kill -s HUP $ids >/dev/null
}

# Réessaie toutes les $RETRY s les dépôts refusés : une clé de déploiement posée sur
# GitHub suffit, la pile n'a pas à être redéployée.
cmd_repos() {
  pending="$(printf '%s' "${OMP_HARNESS_REPOS:-}" | tr ', ' '\n\n' | sed '/^$/d')"
  [ -n "$pending" ] || { echo "· Aucun dépôt dans OMP_HARNESS_REPOS"; exit 0; }
  round=0
  while [ -n "$pending" ]; do
    left=""
    added=0
    for url in $pending; do
      url="$(ssh_url "$url")"
      code=0
      harness_main --add-repo "$url" || code=$?
      case "$code" in
        0) added=1 ;;
        3|4) left="$left $url"; [ $((round % 20)) -ne 0 ] || deploy_key_help "$url" ;;
        *) left="$left $url" ;;
      esac
    done
    [ "$added" = 0 ] || reload_harness
    pending="$left"
    [ -n "$pending" ] || break
    [ "$round" -ne 0 ] || echo "· Nouvel essai toutes les ${RETRY} s :$pending"
    round=$((round + 1))
    sleep "$RETRY"
  done
  echo "✓ dépôts déclarés"
}

# Le code approbateur des apps (Mac et iPhone), le seul qui approuve, refuse ou règle
# le poste : (re)crée le client app-approbateur — l'ancien code cesse de valoir — et
# imprime le code d'appairage du service `pairing` (adresses écrites par lui dans
# published.env) suivi de ce jeton en 5e ligne. Jamais dans les journaux de la pile.
cmd_approver() {
  [ -s "$ROOT/state/token" ] || die "le harness n'a pas encore démarré : attends le service harness, puis relance"
  url="$(setting URL "$ROOT/published/published.env")"
  mem0_url="$(setting MEM0_URL "$ROOT/published/published.env")"
  [ -n "$url" ] && [ -n "$mem0_url" ] ||
    die "adresses du tailnet inconnues : attends que le service pairing affiche son code (Pull and redeploy s'il date d'avant cette version), puis relance"
  mem0_token="$(setting MEM0_HTTP_TOKEN "${OMP_HARNESS_ENV_FILE:-$SECRETS/harness/harness.env}")"
  [ -n "$mem0_token" ] || die "jeton de la mémoire introuvable : lance cette commande dans le conteneur harness"
  harness_main --revoke-client app-approbateur >/dev/null 2>&1 || true
  token="$(harness_main --add-client app-approbateur --approver)" || exit 1
  code="$(printf '%s\n%s\n%s\n%s\n%s\n' "$url" "$(tr -d '\n' < "$ROOT/state/token")" "$mem0_url" "$mem0_token" "$token" |
    base64 | tr -d '\n=' | tr '+/' '-_')"
  echo "Code approbateur (secret : il approuve les envois du poste ; il ne sera plus affiché) :"
  echo
  echo "  omp1:$code"
  echo
  echo "Dans OMP Console, feuille Serveur (Mac et iPhone ; « Oublier ce serveur » d'abord si l'app est déjà reliée)."
  echo "omp /pair et l'extension Chrome refusent ce code : ils gardent celui du service pairing."
}

case "${1:-}" in
  init) cmd_init ;;
  repos) cmd_repos ;;
  approver) cmd_approver ;;
  *) die "usage : omp-harness-stack init | repos | approver" ;;
esac
