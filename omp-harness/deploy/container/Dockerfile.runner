# L'image des runners : omp à la version de l'app Mac, vérifié contre des empreintes
# épinglées (les mêmes que deploy/install.sh), git, et le plugin mémoire que chaque
# runner charge (`-e`). L'entrée lit les clés montées dans /run/secrets/runner.env.
ARG BASE_IMAGE=docker.io/library/debian:bookworm-slim
FROM ${BASE_IMAGE}
ARG TARGETARCH
ARG OMP_VERSION=18.6.0
# Les paquets absents de l'image de base, et eux seuls.
ARG PACKAGES="ca-certificates curl git bash"
RUN missing="$(for p in $PACKAGES; do dpkg -s "$p" >/dev/null 2>&1 || echo "$p"; done)"; \
    if [ -n "$missing" ]; then apt-get update && apt-get install -y --no-install-recommends $missing && rm -rf /var/lib/apt/lists/*; fi
RUN set -eu; \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) asset=omp-linux-x64; sha=844c640c620ec4c152abe4b3736049f963205da50e9e77bd9bdf2a981a6ead55 ;; \
      arm64) asset=omp-linux-arm64; sha=542083fe42a6169565861a4ee9118fbed64d09c93468b6907e6016cc76ef00d1 ;; \
      *) echo "architecture non prise en charge par omp : ${TARGETARCH:-?}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/can1357/oh-my-pi/releases/download/v${OMP_VERSION}/${asset}" -o /usr/local/bin/omp; \
    echo "${sha}  /usr/local/bin/omp" | sha256sum -c --quiet -; \
    chmod 0755 /usr/local/bin/omp
COPY omp-mem0-memory /opt/omp-harness/omp-mem0-memory
COPY omp-harness/deploy/container/runner-entrypoint /usr/local/bin/omp-runner-entrypoint
# Le HOME des runners : monté depuis l'hôte (connexion OMP, profil), inscriptible
# par n'importe quel uid à défaut.
RUN mkdir -p /home/runner && chmod 1777 /home/runner && chmod o+w /etc/passwd
ENV HOME=/home/runner
ENTRYPOINT ["/usr/local/bin/omp-runner-entrypoint"]
CMD ["omp", "--version"]
