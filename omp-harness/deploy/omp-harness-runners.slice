# Les runners OMP (une scope de 1 Go chacun, 5 au plus). Enfant de omp-harness.slice.
[Unit]
Description=OMP harness — runners

[Slice]
MemoryMax=5G
# oomd les tue sous pression, mais APRÈS les jobs heavy (préférence « avoid »).
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=80%
ManagedOOMPreference=avoid
