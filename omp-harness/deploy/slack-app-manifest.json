{
  "display_information": {
    "name": "OMP Poste",
    "description": "Lecture seule des messages de l'utilisateur pour le poste de travail (jeton utilisateur, aucun bot)."
  },
  "oauth_config": {
    "redirect_urls": ["http://localhost/omp-canaux"],
    "scopes": {
      "user": [
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "channels:read",
        "groups:read",
        "im:read",
        "mpim:read",
        "users:read",
        "users:read.email",
        "search:read"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
