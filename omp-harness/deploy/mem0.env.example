# /etc/omp-harness/mem0.env (root 0600) — l'oracle mem0-rs du VPS.
# Le modèle d'embedding tourne sur le homelab, joint par Tailscale (API compatible OpenAI).
OMLX_BASE_URL=http://homelab:8000/v1
OMLX_API_TOKEN=
OMLX_LLM_MODEL=qwen3-8b
OMLX_EMBED_MODEL=bge-m3
# Doit correspondre EXACTEMENT au modèle d'embedding (bge-m3 = 1024) — et à la base
# copiée depuis le Mac, le cas échéant.
EMBEDDING_DIMS=1024
MEM0_DB_PATH=/var/lib/omp-mem0/mem0-rs.db
# Généré par install.sh ; le service et les runners envoient la même valeur.
MEM0_HTTP_TOKEN=
